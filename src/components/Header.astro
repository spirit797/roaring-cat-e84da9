---
import { site } from '../data/site';
const navItems = [
  ['#leistungen', 'Leistungen'],
  ['#preise', 'Preise'],
  ['#fernwartung', 'Fernwartung'],
  ['#ueber-uns', 'Über uns'],
  ['#kontakt', 'Kontakt'],
];
---
<style>
  header {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background .3s, border-color .3s, backdrop-filter .3s;
  }
  header.scrolled {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }
  .nav-inner { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .logo { font-family: var(--font-mono); font-weight: 700; font-size: 18px; letter-spacing: 0.02em; color: var(--text); }
  .logo .r { color: var(--accent-strong); }
  .logo small { display: block; font-size: 9px; letter-spacing: 0.32em; color: var(--faint); text-transform: uppercase; }
  .nav-links { display: flex; align-items: center; gap: 30px; }
  .nav-link { position: relative; font-size: 14px; color: var(--muted); transition: color .2s; padding: 6px 0; }
  .nav-link::after { content: ""; position: absolute; left: 0; bottom: 0; height: 1px; width: 0; background: var(--accent); transition: width .28s var(--ease); }
  .nav-link:hover, .nav-link.active { color: var(--text); }
  .nav-link.active::after, .nav-link:hover::after { width: 100%; }
  .nav-actions { display: flex; align-items: center; gap: 14px; }
  .nav-cta { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.05em; }
  .nav-nas { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11.5px; color: var(--faint); border: 1px solid var(--line); padding: 6px 10px; border-radius: var(--radius); transition: color .2s, border-color .2s; }
  .nav-nas:hover { color: var(--text); border-color: var(--line-strong); }
  .icon-btn { background: none; border: 1px solid transparent; color: var(--muted); cursor: pointer; width: 40px; height: 40px; border-radius: var(--radius); display: inline-flex; align-items: center; justify-content: center; transition: color .2s, background .2s; }
  .icon-btn:hover { color: var(--text); background: var(--panel-2); }
  .icon-hide { display: none !important; }

  /* Mobil */
  @media (max-width: 900px) {
    .nav-links, .nav-nas, .nav-cta { display: none; }
    .menu-btn { display: inline-flex; }
  }
  @media (min-width: 901px) {
    .menu-btn { display: none; }
  }

  /* Mobiles Dropdown */
  #mobileMenu { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s var(--ease); overflow: hidden; border-top: 1px solid var(--line); }
  #mobileMenu.open { grid-template-rows: 1fr; }
  #mobileMenu > .inner { min-height: 0; overflow: hidden; background: var(--bg-2); }
  .mm-link { display: block; font-family: var(--font-sans); padding: 15px 26px; color: var(--text); border-bottom: 1px solid var(--line); transition: background .2s, padding-left .2s, color .2s; }
  .mm-link:hover { background: var(--panel); color: var(--accent-ink); padding-left: 32px; }
  .mm-cta { display: block; margin: 16px 26px 24px; }
</style>

<header id="navbar">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="Zur Startseite">
      KISTLER<span class="r">-IT</span>
      <small>IT-SUPPORT · USTER</small>
    </a>

    <nav class="nav-links" aria-label="Hauptnavigation">
      {navItems.map(([href, label]) => <a class="nav-link" href={href}>{label}</a>)}
    </nav>

    <div class="nav-actions">
      <a class="nav-nas" href={site.nas} target="_blank" rel="noopener noreferrer" title="Synology NAS">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        NAS
      </a>
      <a class="btn btn-primary nav-cta" href="#kontakt">ANFRAGE</a>
      <button id="themeToggle" class="icon-btn" aria-label="Theme wechseln">
        <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
        <svg id="iconMoon" class="icon-hide" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      </button>
      <button id="menuBtn" class="icon-btn menu-btn" aria-label="Menü öffnen" aria-expanded="false">
        <svg id="menuIcon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="closeIcon" class="icon-hide" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <div id="mobileMenu">
    <div class="inner">
      {navItems.map(([href, label]) => <a class="mm-link" href={href}>{label}</a>)}
      <a class="btn btn-primary mm-cta" href="#kontakt">Jetzt anfragen</a>
    </div>
  </div>
</header>
