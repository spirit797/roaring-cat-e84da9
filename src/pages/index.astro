---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { site, stats, services, plans, priceFootnote, fernwartung, values, about, serviceStatus } from '../data/site';

const statusLabel: Record<string, string> = {
  online: '● ONLINE',
  warning: '● EINGESCHRÄNKT',
  outage: '● STÖRUNG',
  maintenance: '● WARTUNG',
};
const dotClass = `dot status-${serviceStatus.state}`;
---

<style>
  /* ===== HERO ===== */
  .hero {
    min-height: 100vh; display: flex; align-items: center;
    position: relative; overflow: hidden; padding-top: 140px; padding-bottom: 80px;
  }
  .hero .glow {
    position: absolute; border-radius: 50%; filter: blur(90px); pointer-events: none;
    background: var(--accent); opacity: 0.16;
  }
  .glow.g1 { width: 520px; height: 520px; top: -120px; left: -80px; animation: drift 18s ease-in-out infinite; }
  .glow.g2 { width: 420px; height: 420px; bottom: -100px; right: -60px; background: #7a1616; animation: drift 22s ease-in-out infinite reverse; }
  @keyframes drift { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(50px,40px) scale(1.08)} }
  .hero-inner { position: relative; z-index: 2; max-width: 860px; }
  .term { font-family: var(--font-mono); font-size: 13.5px; color: var(--accent-ink); display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--accent-line); background: var(--accent-dim); padding: 8px 16px; border-radius: var(--radius); }
  .term .prompt { color: var(--muted); }
  .term .dot { color: var(--ok); }
  .term .dot.status-warning { color: #f0b429; }
  .term .dot.status-outage { color: var(--accent-strong); }
  .term .dot.status-maintenance { color: var(--muted); }
  .status-msg { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); margin: 12px 0 0; }
  .status-msg::before { content: '// '; color: var(--accent-ink); }
  .hero h1 { font-size: clamp(42px, 7vw, 74px); margin: 30px 0 24px; font-weight: 700; letter-spacing: -0.02em; }
  .hero h1 .kicker { display: block; font-family: var(--font-mono); font-size: clamp(13px, 1.6vw, 15px); font-weight: 400; color: var(--muted); letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px; }
  .hero h1 .redline { color: var(--accent-strong); }
  .cursor { display: inline-block; width: 0.6em; height: 1em; background: var(--accent-strong); margin-left: 6px; vertical-align: -0.12em; animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero .sub { color: var(--muted); font-size: clamp(16px, 2.2vw, 19px); max-width: 560px; margin-bottom: 38px; }
  .hero-cta { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 72px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); max-width: 760px; }
  .stat { background: var(--panel); padding: 26px 20px; }
  .stat b { display: block; font-family: var(--font-mono); font-size: clamp(28px, 4.4vw, 42px); font-weight: 700; color: var(--accent-strong); font-variant-numeric: tabular-nums; line-height: 1; }
  .stat span { display: block; margin-top: 10px; font-size: 13.5px; color: var(--muted); }
  .scroll-hint { position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--faint); }
  .scroll-hint .line { display: block; width: 1px; height: 44px; margin: 10px auto 0; background: linear-gradient(var(--accent-strong), transparent); animation: drop 1.7s var(--ease) infinite; }
  @keyframes drop { 0%{transform:scaleY(0);transform-origin:top} 45%{transform:scaleY(1);transform-origin:top} 55%{transform:scaleY(1);transform-origin:bottom} 100%{transform:scaleY(0);transform-origin:bottom} }

  /* ===== SERVICES ===== */
  #leistungen { background: var(--bg-2); }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 60px; }
  .svc { padding: 30px; transition: transform .3s var(--ease), border-color .3s, box-shadow .3s; }
  .svc:hover { transform: translateY(-6px); border-color: var(--accent-line); box-shadow: 0 30px 60px -30px rgba(0,0,0,.7); }
  .svc .top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22px; }
  .svc .no { font-family: var(--font-mono); font-size: 12px; color: var(--accent-ink); border: 1px solid var(--accent-line); border-radius: var(--radius); padding: 3px 8px; }
  .svc .ico { color: var(--accent-strong); line-height: 1; }
  .svc .ico svg { display: block; }
  .svc h3 { font-size: 20px; margin-bottom: 10px; }
  .svc p { color: var(--muted); font-size: 14.5px; margin-bottom: 20px; }
  .svc ul li { display: flex; align-items: center; gap: 10px; font-size: 14px; padding: 5px 0; color: var(--text); }
  .svc ul li::before { content: ""; width: 5px; height: 5px; background: var(--accent); flex-shrink: 0; }

  /* ===== PRICING ===== */
  #preise { background: var(--bg); }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; margin-top: 60px; }
  .plan { padding: 40px 30px; display: flex; flex-direction: column; height: 100%; }
  .plan.featured { border-color: var(--accent-line); background: linear-gradient(180deg, var(--accent-dim), var(--panel) 45%); box-shadow: 0 0 0 1px var(--accent-line), 0 30px 60px -30px rgba(225,29,29,.4); }
  .plan .tag { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; background: var(--accent); padding: 4px 12px; border-radius: var(--radius); }
  .plan h3 { font-size: 15px; font-family: var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .plan .desc { font-size: 14px; color: var(--muted); margin-bottom: 26px; min-height: 44px; }
  .price { font-family: var(--font-mono); display: flex; align-items: baseline; gap: 4px; margin-bottom: 26px; }
  .price .cur { font-size: 14px; color: var(--faint); }
  .price b { font-size: 52px; font-weight: 700; color: var(--accent-strong); font-variant-numeric: tabular-nums; line-height: 1; }
  .price .unit { font-size: 13px; color: var(--faint); }
  .plan ul { margin-bottom: 28px; flex: 1; }
  .plan li { display: flex; gap: 11px; padding: 7px 0; font-size: 14px; color: var(--text); }
  .plan li svg { flex-shrink: 0; width: 15px; height: 15px; margin-top: 4px; color: var(--accent-strong); }
  .plan .btn { width: 100%; }
  .footnote { text-align: center; font-family: var(--font-mono); font-size: 12.5px; color: var(--faint); margin-top: 40px; }

  /* ===== FERNWARTUNG ===== */
  #fernwartung { background: var(--bg-2); }
  .split { display: grid; grid-template-columns: 1.05fr .95fr; gap: 60px; align-items: center; margin-top: 0; }
  .fw-points { margin: 30px 0 36px; }
  .fw-points li { display: flex; gap: 14px; align-items: flex-start; padding: 9px 0; color: var(--text); font-size: 15px; }
  .fw-points .chk { flex-shrink: 0; width: 22px; height: 22px; margin-top: 2px; border: 1px solid var(--accent-line); background: var(--accent-dim); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--accent-strong); }
  .fw-points .chk svg { width: 12px; height: 12px; }
  .dl-stack { display: flex; flex-direction: column; gap: 14px; }
  .fw-note { font-size: 14px; color: var(--muted); }
  .dl-card { padding: 26px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  .dl-card:hover { border-color: var(--accent-line); }
  .dl-card h3 { font-size: 17px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .dl-card .rec { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); background: var(--accent-dim); border: 1px solid var(--accent-line); padding: 3px 8px; border-radius: var(--radius); }
  .dl-card p { color: var(--muted); font-size: 13px; margin-top: 8px; }
  .info-box { border: 1px solid var(--accent-line); background: var(--accent-dim); padding: 20px; font-size: 14px; color: var(--muted); }
  .info-box b { color: var(--accent-strong); font-family: var(--font-mono); }

  /* ===== ÜBER UNS ===== */
  #ueber-uns { background: var(--bg); }
  .vals { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .val { padding: 26px; }
  .val:hover { border-color: var(--accent-line); }
  .val .vico { margin-bottom: 14px; }
  .val .vico svg { color: var(--accent-strong); }
  .val h3 { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 8px; }
  .val p { color: var(--muted); font-size: 14px; }
  .about-text { margin-bottom: 30px; color: var(--muted); font-size: 16px; }
  .about-text p { margin-bottom: 14px; }
  .contact-rows div { display: flex; align-items: center; gap: 12px; padding: 9px 0; color: var(--text); font-size: 15px; }
  .contact-rows .ci { width: 30px; text-align: center; font-size: 16px; color: var(--accent-strong); }

  /* ===== KONTAKT ===== */
  #kontakt { background: var(--bg-2); }
  .kontakt-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 24px; align-items: start; margin-top: 60px; }
  .box { padding: 34px; }
  .box h3 { font-size: 20px; margin-bottom: 20px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .direct { display: flex; flex-direction: column; }
  .direct a, .direct .st { display: flex; align-items: center; gap: 16px; padding: 12px; border-radius: var(--radius); transition: background .2s, transform .2s; }
  .direct a:hover { background: var(--panel-2); transform: translateX(4px); }
  .direct .ic { width: 46px; height: 46px; flex-shrink: 0; border: 1px solid var(--accent-line); background: var(--accent-dim); border-radius: var(--radius); display: flex; align-items: center; justify-content: center; }
  .direct .ic svg { color: var(--accent-strong); }
  .direct .lbl { display: block; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .direct .val { display: block; font-size: 15px; font-weight: 600; color: var(--text); margin-top: 2px; }
  .direct .st { cursor: default; }
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .cal-shell { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg-2); }
  .calendly-inline-widget { min-width: 100%; height: 420px; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
    .plans { grid-template-columns: 1fr; max-width: 480px; margin-left: auto; margin-right: auto; }
    .split { grid-template-columns: 1fr; gap: 44px; }
    .kontakt-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .svc-grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .vals { grid-template-columns: 1fr; }
    .row2 { grid-template-columns: 1fr; }
    .section { padding: 80px 0; }
  }
</style>

<Base>
  <!-- ============================================ HERO -->
  <section class="hero" id="hero">
    <div class="grid-overlay"></div>
    <div class="glow g1"></div>
    <div class="glow g2"></div>

    <div class="container hero-inner">
      <span class="term" data-reveal>
        <span class="prompt">$</span>
        <span>it-status --region {serviceStatus.region}</span>
        <span class={dotClass}>{statusLabel[serviceStatus.state]}</span>
      </span>
      {serviceStatus.message && (
        <p class="status-msg" data-reveal>{serviceStatus.message}</p>
      )}

      <h1 data-reveal>
        <span class="kicker">IT-Probleme?</span>
        Wir <span class="redline">lösen</span> sie<span class="cursor"></span>
      </h1>

      <p class="sub" data-reveal>{site.tagline} Schnell, zuverlässig und persönlich.</p>

      <div class="hero-cta" data-reveal>
        <a class="btn btn-primary btn-lg btn-mono" href="#kontakt">Kostenlose Beratung <span class="arrow">→</span></a>
        <a class="btn btn-ghost btn-lg btn-mono" href="#leistungen"><span class="arrow">[</span> Leistungen ansehen</a>
      </div>

      <div class="stats" data-reveal>
        {stats.map((s) => (
          <div class="stat">
            <b data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</b>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="scroll-hint">Scroll<span class="line"></span></div>
  </section>

  <!-- ============================================ LEISTUNGEN -->
  <section class="section" id="leistungen">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="section-code">[ 01 ] Unser Angebot</span>
        <h2 class="section-heading">Unsere <span style="color:var(--accent-strong)">Leistungen</span></h2>
        <p class="section-lead">Von der einfachen PC-Reparatur bis zur kompletten IT-Infrastruktur — wir sind Ihr Partner für alle IT-Fragen.</p>
      </div>

      <div class="svc-grid">
        {services.map((s, i) => (
          <article class="panel corner svc" data-reveal style={`transition-delay:${(i % 3) * 70}ms`}>
            <span class="c1"></span><span class="c2"></span>
            <div class="top"><span class="ico"><Icon name={`lucide:${s.icon}`} size={34} /></span><span class="no">0{s.no}</span></div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <ul>
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ PREISE -->
  <section class="section" id="preise">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="section-code">[ 02 ] Transparente Preise</span>
        <h2 class="section-heading">Faire <span style="color:var(--accent-strong)">Preise</span></h2>
        <p class="section-lead">Keine versteckten Kosten. Klare Preise für klare Leistungen.</p>
      </div>

      <div class="plans">
        {plans.map((p, i) => (
          <article class={`plan panel corner ${p.featured ? 'featured' : ''}`} data-reveal style={`transition-delay:${i * 90}ms`}>
            <span class="c1"></span><span class="c2"></span>
            {p.featured && <span class="tag">Beliebteste Wahl</span>}
            <h3>{p.name}</h3>
            <p class="desc">{p.desc}</p>
            <div class="price">
              <span class="cur">CHF</span>
              <b data-count={p.price}>{p.price}</b>
              <span class="unit">/ {p.unit.split(' ').slice(1).join(' ')}</span>
            </div>
            <ul>
              {p.items.map((it) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                  {it}
                </li>
              ))}
            </ul>
            <a class={`btn ${p.featured ? 'btn-primary' : 'btn-ghost'} btn-mono`} href="#kontakt">Jetzt anfragen</a>
          </article>
        ))}
      </div>

      <p class="footnote">{priceFootnote}</p>
    </div>
  </section>

  <!-- ============================================ FERNWARTUNG -->
  <section class="section" id="fernwartung">
    <div class="container split">
      <div data-reveal>
        <span class="section-code">[ 03 ] Remote Support</span>
        <h2 class="section-heading">Hilfe per <span style="color:var(--accent-strong)">Fernwartung</span></h2>
        <p class="section-lead">{fernwartung.lead}</p>
        <ul class="fw-points">
          {fernwartung.points.map((pt) => (
            <li>
              <span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>
              {pt}
            </li>
          ))}
        </ul>
        <div class="hero-cta">
          <a class="btn btn-primary btn-mono" href="#kontakt">Fernwartung anfordern <span class="arrow">→</span></a>
          <a class="btn btn-ghost btn-mono" href="/fernwartung-zeiten"><span class="arrow">🕐</span> Verfügbare Zeiten</a>
        </div>
      </div>

      <div class="dl-stack" data-reveal>
        <p class="fw-note">Bitte laden Sie <strong style="color:var(--text)">vor dem Support-Termin</strong> folgende App herunter:</p>
        <div class="panel dl-card">
          <div>
            <h3>Supremo Remote Desktop <span class="rec">Empfohlen</span></h3>
            <p>{fernwartung.app.desc}</p>
          </div>
          <a class="btn btn-primary btn-mono" href={fernwartung.app.download} target="_blank" rel="noopener noreferrer">Download</a>
        </div>
        <div class="info-box"><b>So funktioniert es:</b> {fernwartung.app.how}</div>
      </div>
    </div>
  </section>

  <!-- ============================================ ÜBER UNS -->
  <section class="section" id="ueber-uns">
    <div class="container split">
      <div class="vals" data-reveal>
        {values.map((v, i) => (
          <div class="panel corner val" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="c1"></span><span class="c2"></span>
            <div class="vico"><Icon name={`lucide:${v.icon}`} size={28} /></div>
            <h3>{v.title}</h3>
            <p>{v.desc}</p>
          </div>
        ))}
      </div>

      <div data-reveal>
        <span class="section-code">[ 04 ] Über uns</span>
        <h2 class="section-heading">Ihr IT-Partner <span style="color:var(--accent-strong)">aus Uster</span></h2>
        <div class="about-text">
          {about.map((p) => <p>{p}</p>)}
        </div>
        <div class="contact-rows">
          <div><span class="ci"><Icon name="lucide:user" size={16} /></span> {site.owner}</div>
          <div><span class="ci"><Icon name="lucide:map-pin" size={16} /></span> {site.location}</div>
          <div><span class="ci"><Icon name="lucide:phone" size={16} /></span> {site.phone}</div>
          <div><span class="ci"><Icon name="lucide:smartphone" size={16} /></span> {site.mobile}</div>
          <div><span class="ci"><Icon name="lucide:mail" size={16} /></span> {site.email}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ KONTAKT -->
  <section class="section" id="kontakt">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="section-code">[ 05 ] Kontakt</span>
        <h2 class="section-heading">Nehmen Sie <span style="color:var(--accent-strong)">Kontakt</span> auf</h2>
        <p class="section-lead">Schildern Sie uns Ihr Problem — wir melden uns schnellstmöglich bei Ihnen.</p>
      </div>

      <div class="kontakt-grid">
        <div class="panel box" data-reveal>
          <h3>Nachricht senden</h3>
          <form id="kontaktForm" action="https://formspree.io/f/mpqjbrnv" method="POST">
            <div class="form-status" id="formStatus" role="status"></div>
            <div class="row2">
              <div class="field">
                <label>Vorname <span class="req">*</span></label>
                <input type="text" name="vorname" required placeholder="Max" />
              </div>
              <div class="field">
                <label>Nachname <span class="req">*</span></label>
                <input type="text" name="nachname" required placeholder="Mustermann" />
              </div>
            </div>
            <div class="field">
              <label>E-Mail <span class="req">*</span></label>
              <input type="email" name="email" required placeholder="max@beispiel.ch" />
            </div>
            <div class="field">
              <label>Telefon</label>
              <input type="tel" name="telefon" placeholder="+41 XX XXX XX XX" />
            </div>
            <div class="field">
              <label>Betreff <span class="req">*</span></label>
              <select name="betreff" required>
                <option value="" disabled selected>Bitte wählen…</option>
                <option value="privatperson">Privatperson – Hilfe benötigt</option>
                <option value="firma">Firma – IT-Support</option>
                <option value="fernwartung">Fernwartung anfordern</option>
                <option value="offerte">Offerte anfragen</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
            </div>
            <div class="field">
              <label>Nachricht <span class="req">*</span></label>
              <textarea name="nachricht" required placeholder="Beschreiben Sie kurz Ihr Anliegen…"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-mono" id="submitBtn" style="width:100%">Nachricht senden <span class="arrow">→</span></button>
          </form>
        </div>

        <div class="stack">
          <div class="panel box" data-reveal>
            <h3>Termin buchen</h3>
            <p style="color:var(--muted);font-size:14px;margin-bottom:20px;">Buchen Sie direkt einen Termin für Vor-Ort-Support oder Fernwartung.</p>
            <div class="cal-shell">
              <div class="calendly-inline-widget" data-url={site.calendly}></div>
            </div>
            <a class="btn btn-ghost btn-mono" style="width:100%;margin-top:16px;" href={site.calendly} target="_blank" rel="noopener noreferrer"><span class="arrow">📅</span> Termin im Kalender buchen</a>
          </div>

          <div class="panel box" data-reveal>
            <h3>Direktkontakt</h3>
            <div class="direct">
              <a href={site.phoneHref}><span class="ic"><Icon name="lucide:phone" size={20} /></span><span><span class="lbl">Festnetz</span><span class="val">{site.phone}</span></span></a>
              <a href={site.mobileHref}><span class="ic"><Icon name="lucide:smartphone" size={20} /></span><span><span class="lbl">Mobile</span><span class="val">{site.mobile}</span></span></a>
              <a href={site.emailHref}><span class="ic"><Icon name="lucide:mail" size={20} /></span><span><span class="lbl">E-Mail</span><span class="val">{site.email}</span></span></a>
              <div class="st"><span class="ic"><Icon name="lucide:map-pin" size={20} /></span><span><span class="lbl">Adresse</span><span class="val">{site.location}</span></span></div>
