---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const schedule = [
  ['So', 'Sonntag', 'Nicht verfügbar', false],
  ['Mo', 'Montag', '08:00 – 10:00 · 18:00 – 20:00', true],
  ['Di', 'Dienstag', '08:00 – 10:00 · 18:00 – 20:00', true],
  ['Mi', 'Mittwoch', '18:00 – 20:00', true],
  ['Do', 'Donnerstag', '08:00 – 10:00 · 18:00 – 20:00', true],
  ['Fr', 'Freitag', 'Nicht verfügbar', false],
  ['Sa', 'Samstag', 'Nicht verfügbar', false],
];
---
<style>
  .page { padding: 150px 0 90px; }
  .code { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); }
  .page h1 { font-size: clamp(30px, 4.5vw, 44px); margin: 14px 0 12px; }
  .intro { color: var(--muted); font-size: 16px; max-width: 640px; margin-bottom: 40px; }
  .table { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; max-width: 640px; }
  .row { display: grid; grid-template-columns: 64px 1fr 1.4fr; border-bottom: 1px solid var(--line); background: var(--panel); }
  .row:last-child { border-bottom: none; }
  .row .c { padding: 16px 18px; }
  .row .day { font-family: var(--font-mono); color: var(--accent-ink); }
  .row .name { color: var(--muted); }
  .row .time { color: var(--text); }
  .row.off .time { color: var(--err); }
  .note { color: var(--muted); font-size: 14px; max-width: 640px; margin: 24px 0 28px; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .back { display: inline-block; margin-top: 34px; font-family: var(--font-mono); color: var(--accent-ink); }
  .back:hover { text-decoration: underline; }
</style>

<Base title={`Fernwartungszeiten – ${site.name}`} description="Verfügbare Zeiten für Fernwartungen bei Kistler-IT">
  <div class="container page">
    <div class="code">[ Fernwartung ]</div>
    <h1>Verfügbare Zeiten</h1>
    <p class="intro">In folgenden Zeitfenstern bin ich für Fernwartungen erreichbar. Bitte laden Sie vorher die Supremo-Software herunter.</p>

    <div class="table">
      {schedule.map(([short, name, time, avail]) => (
        <div class={`row ${avail ? '' : 'off'}`}>
          <div class="c day">{short}</div>
          <div class="c name">{name}</div>
          <div class="c time" style={`${avail ? 'color:var(--ok)' : 'color:var(--err)'}`}>{time}</div>
        </div>
      ))}
    </div>

    <p class="note">Hinweis: Bitte nehmen Sie vor einem Termin Kontakt mit uns auf. Kurzfristige Termine ausserhalb der angezeigten Zeiten sind auf Anfrage möglich.</p>

    <div class="actions">
      <a class="btn btn-primary btn-mono" href="#kontakt">Termin anfragen <span class="arrow">→</span></a>
    </div>

    <a class="back" href="/">← Zurück zur Startseite</a>
  </div>
</Base>
